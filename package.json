{
  "name": "vscodesyncfiles",
  "displayName": "VSCodeSyncFiles",
  "description": "Синхронизация отдельных файлов между машинами через облако",
  "version": "0.4.0",
  "license": "MIT",
  "publisher": "borodatych",
  "repository": {
    "type": "git",
    "url": "https://github.com/borodatych/VSCodeSyncFiles.git"
  },
  "homepage": "https://github.com/borodatych/VSCodeSyncFiles#readme",
  "bugs": {
    "url": "https://github.com/borodatych/VSCodeSyncFiles/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "media/vscodesync.png",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "submenus": [
      {
        "id": "vscodesync.submenu",
        "label": "VSCodeSync"
      }
    ],
    "configuration": {
      "title": "VSCodeSync",
      "properties": {
        "vscodesync.onedriveClientId": {
          "type": "string",
          "default": "",
          "description": "%cfg.onedriveClientId.description%"
        },
        "vscodesync.googleDriveClientId": {
          "type": "string",
          "default": "",
          "description": "%cfg.googleDriveClientId.description%"
        },
        "vscodesync.dropboxAppKey": {
          "type": "string",
          "default": "lsuphteciqwcykn",
          "description": "%cfg.dropboxAppKey.description%"
        },
        "vscodesync.yandexOAuthClientId": {
          "type": "string",
          "default": "6ee27a62c3ba4b05a69b682bef342570",
          "description": "%cfg.yandexOAuthClientId.description%"
        },
        "vscodesync.yandexUseAppFolder": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.yandexUseAppFolder.description%"
        },
        "vscodesync.notificationLevel": {
          "type": "string",
          "enum": [
            "minimal",
            "normal",
            "verbose"
          ],
          "default": "normal",
          "description": "%cfg.notificationLevel.description%"
        },
        "vscodesync.notifications.emojiFree": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.notifications.emojiFree.description%"
        },
        "vscodesync.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.codeLens.enabled.description%"
        },
        "vscodesync.inlineConflictCodeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.inlineConflictCodeLens.enabled.description%"
        },
        "vscodesync.massChangeGuard": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.massChangeGuard.description%"
        },
        "vscodesync.presenceHeartbeatMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 60,
          "description": "%cfg.presenceHeartbeatMinutes.description%"
        },
        "vscodesync.backup.secondaryProvider": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "onedrive",
            "gdrive",
            "yandex",
            "dropbox"
          ],
          "description": "%cfg.backup.secondaryProvider.description%"
        },
        "vscodesync.backup.intervalDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 90,
          "description": "%cfg.backup.intervalDays.description%"
        },
        "vscodesync.webhooks.tunnelProvider": {
          "type": "string",
          "default": "smee",
          "enum": [
            "smee",
            "cloudflared",
            "tailscale-funnel"
          ],
          "description": "%cfg.webhooks.tunnelProvider.description%"
        },
        "vscodesync.showFileDecorations": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showFileDecorations.description%"
        },
        "vscodesync.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "%cfg.maxFileSizeMB.description%"
        },
        "vscodesync.warnOnBinaryFiles": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.warnOnBinaryFiles.description%"
        },
        "vscodesync.showPreview": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showPreview.description%"
        },
        "vscodesync.syncSummaryOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.syncSummaryOnStartup.description%"
        },
        "vscodesync.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.telemetry.description%"
        },
        "vscodesync.telemetryIngestUrl": {
          "type": "string",
          "default": "",
          "description": "%cfg.telemetryIngestUrl.description%"
        },
        "vscodesync.quickTransferTtlDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 365,
          "description": "%cfg.quickTransferTtlDays.description%"
        },
        "vscodesync.compressUploads": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.compressUploads.description%"
        },
        "vscodesync.lineEnding": {
          "type": "string",
          "enum": [
            "lf",
            "crlf",
            "preserve"
          ],
          "default": "lf",
          "description": "%cfg.lineEnding.description%"
        },
        "vscodesync.workspaceInactiveDays": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "maximum": 3650,
          "description": "%cfg.workspaceInactiveDays.description%"
        },
        "vscodesync.batchAddWarnThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "%cfg.batchAddWarnThreshold.description%"
        },
        "vscodesync.pushOnCommit": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.pushOnCommit.description%"
        },
        "vscodesync.conflictRules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "strategy"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Minimatch-glob относительно корня workspace (например '*.lock' или 'config/shared/**')"
              },
              "strategy": {
                "type": "string",
                "enum": [
                  "keep-mine",
                  "take-theirs",
                  "newer"
                ],
                "description": "Автостратегия разрешения конфликта при матче по pattern"
              }
            }
          },
          "description": "%cfg.conflictRules.description%"
        },
        "vscodesync.localBackupEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.localBackupEnabled.description%"
        },
        "vscodesync.localBackupRetentionDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "description": "%cfg.localBackupRetentionDays.description%"
        },
        "vscodesync.snapshotRetentionDays": {
          "type": "number",
          "default": 180,
          "minimum": 1,
          "description": "%cfg.snapshotRetentionDays.description%"
        },
        "vscodesync.maxSnapshotsPerWorkspace": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "%cfg.maxSnapshotsPerWorkspace.description%"
        },
        "vscodesync.snapshotSchedule": {
          "type": "string",
          "default": "",
          "pattern": "^$|^daily \\d{1,2}:\\d{2}$|^weekly (sun|mon|tue|wed|thu|fri|sat) \\d{1,2}:\\d{2}$",
          "description": "%cfg.snapshotSchedule.description%"
        },
        "vscodesync.longAbsenceThresholdDays": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "%cfg.longAbsenceThresholdDays.description%"
        },
        "vscodesync.monthlyBandwidthLimitMB": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%cfg.monthlyBandwidthLimitMB.description%"
        },
        "vscodesync.syncOnFocusDelayMs": {
          "type": "number",
          "default": 3000,
          "minimum": 0,
          "description": "%cfg.syncOnFocusDelayMs.description%"
        },
        "vscodesync.syncOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.syncOnOpen.description%"
        },
        "vscodesync.smartSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.smartSuggestions.description%"
        },
        "vscodesync.digestIntervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "%cfg.digestIntervalMinutes.description%"
        },
        "vscodesync.activityRetentionDays": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 3650,
          "description": "%cfg.activityRetentionDays.description%"
        },
        "vscodesync.requireMachineApproval": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.requireMachineApproval.description%"
        },
        "vscodesync.pauseOnMeteredConnection": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.pauseOnMeteredConnection.description%"
        },
        "vscodesync.pauseBatteryThreshold": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "maximum": 100,
          "description": "%cfg.pauseBatteryThreshold.description%"
        },
        "vscodesync.encryption": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.encryption.description%"
        },
        "vscodesync.aiMerge": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.aiMerge.description%"
        },
        "vscodesync.webhooks.tunnelEnabled": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.webhooks.tunnelEnabled.description%"
        },
        "vscodesync.gitBranchAutoSync": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.gitBranchAutoSync.description%"
        },
        "vscodesync.watchMode": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.watchMode.description%"
        },
        "vscodesync.watchIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "%cfg.watchIntervalSeconds.description%"
        },
        "vscodesync.watchMaxIntervalSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "description": "%cfg.watchMaxIntervalSeconds.description%"
        },
        "vscodesync.watchAdaptive": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.watchAdaptive.description%"
        },
        "vscodesync.syncSchedule": {
          "type": "object",
          "markdownDescription": "Окно времени для **автоматических** триггеров (onSave debounce, onFocus, onOpen, Git push-on-commit, watch poll, startup pull). Ручные команды VSCodeSync выполняются всегда. Вне окна операции накапливаются в `schedule-deferred.json` в каталоге расширения и выполняются при входе в активное окно.",
          "default": {
            "enabled": false,
            "activeHours": "09:00-18:00",
            "activeDays": [
              "Mon",
              "Tue",
              "Wed",
              "Thu",
              "Fri"
            ],
            "timezone": "auto"
          },
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Включить ограничение автосинхронизации по расписанию"
            },
            "activeHours": {
              "type": "string",
              "default": "09:00-18:00",
              "description": "Интервал локального времени «HH:mm-HH:mm» (допускается переход через полночь)"
            },
            "activeDays": {
              "type": "array",
              "default": [
                "Mon",
                "Tue",
                "Wed",
                "Thu",
                "Fri"
              ],
              "items": {
                "type": "string"
              },
              "description": "Дни недели (Mon…Sun или полные имена). Пустой список = все дни"
            },
            "timezone": {
              "type": "string",
              "default": "auto",
              "description": "IANA (Europe/Moscow) или auto — системная зона"
            }
          },
          "additionalProperties": true
        },
        "vscodesync.deltaSync": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.deltaSync.description%"
        },
        "vscodesync.deltaThresholdKB": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "%cfg.deltaThresholdKB.description%"
        },
        "vscodesync.webhooks.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.webhooks.enabled.description%"
        },
        "vscodesync.webhooks.url": {
          "type": "string",
          "default": "",
          "description": "%cfg.webhooks.url.description%"
        },
        "vscodesync.webhooks.localPort": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "%cfg.webhooks.localPort.description%"
        },
        "vscodesync.webhooks.fallbackAfterMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 10080,
          "description": "%cfg.webhooks.fallbackAfterMinutes.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscodesync",
          "title": "VSCodeSync",
          "icon": "media/vscodesync.svg"
        }
      ]
    },
    "views": {
      "vscodesync": [
        {
          "id": "vscodesync.workspaces",
          "name": "Workspaces"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "vscodesync.getStarted",
        "title": "VSCodeSync — первые шаги",
        "description": "Подключите облако, создайте первый workspace и научитесь работать со снапшотами.",
        "steps": [
          {
            "id": "selectProvider",
            "title": "Выберите провайдер",
            "description": "VSCodeSync поддерживает OneDrive, Google Drive, Dropbox и Yandex.Disk. Войдите в один из них через команду «Сменить провайдер».\n\n[Открыть онбординг](command:vscodesync.startOnboarding)",
            "media": {
              "image": "media/vscodesync.png",
              "altText": "VSCodeSync logo"
            },
            "completionEvents": [
              "onCommand:vscodesync.setActiveProvider",
              "onCommand:vscodesync.startOnboarding"
            ]
          },
          {
            "id": "createWorkspace",
            "title": "Создайте первый workspace",
            "description": "Workspace — это группа файлов, которая синхронизируется как одно целое.\n\n[Создать workspace](command:vscodesync.createWorkspace)",
            "media": {
              "image": "media/vscodesync.png",
              "altText": "VSCodeSync logo"
            },
            "completionEvents": [
              "onCommand:vscodesync.createWorkspace"
            ]
          },
          {
            "id": "addFile",
            "title": "Добавьте файл в синхронизацию",
            "description": "ПКМ на любом файле в Explorer → VSCodeSync → Add file. Файл попадёт в облако и автоматически синхронизируется со всеми вашими машинами.",
            "media": {
              "image": "media/vscodesync.png",
              "altText": "VSCodeSync logo"
            },
            "completionEvents": [
              "onCommand:vscodesync.addFile"
            ]
          },
          {
            "id": "snapshot",
            "title": "Сделайте снапшот",
            "description": "Снапшот — это точка восстановления для всего workspace. Можно настроить расписание через `vscodesync.snapshotSchedule` (например, `daily 03:00`).\n\n[Создать снапшот](command:vscodesync.createSnapshot)",
            "media": {
              "image": "media/vscodesync.png",
              "altText": "VSCodeSync logo"
            },
            "completionEvents": [
              "onCommand:vscodesync.createSnapshot"
            ]
          },
          {
            "id": "quickSwitch",
            "title": "Хоткей быстрого переключения",
            "description": "`Ctrl+Alt+W` (`Cmd+Alt+W` на Mac) открывает QuickPick всех ваших workspace. Воркспейсы отсортированы по последней синхронизации.\n\n[Попробовать](command:vscodesync.quickSwitchWorkspace)",
            "media": {
              "image": "media/vscodesync.png",
              "altText": "VSCodeSync logo"
            },
            "completionEvents": [
              "onCommand:vscodesync.quickSwitchWorkspace"
            ]
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "vscodesync.workspaces",
        "contents": "В этом проекте пока нет подключённых workspace.\n\n[Создать первый workspace](command:vscodesync.createWorkspace)\n[Подключить существующий](command:vscodesync.connectCloudWorkspace)\n\nНе уверены с чего начать? Запустите [онбординг](command:vscodesync.startOnboarding) или откройте [гайд по провайдерам](command:vscodesync.showProviderSetupGuide).",
        "when": "workspaceFolderCount != 0"
      },
      {
        "view": "vscodesync.workspaces",
        "contents": "Откройте папку проекта, чтобы начать синхронизацию.\n\n[Открыть папку](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "taskDefinitions": [
      {
        "type": "vscodesync",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "push",
              "pull",
              "push-all",
              "pull-all",
              "create-snapshot"
            ],
            "description": "Операция VSCodeSync: sync по workspace, все файлы или снапшот."
          },
          "workspace": {
            "type": "string",
            "description": "Идентификатор облачного workspace. Если в папке один workspace — можно опустить."
          },
          "file": {
            "type": "string",
            "description": "Путь файла относительно корня (POSIX); для push/pull одного файла."
          },
          "snapshotName": {
            "type": "string",
            "description": "Имя снапшота для задачи create-snapshot."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "vscodesync.showStatus",
        "title": "%cmd.showStatus.title%"
      },
      {
        "command": "vscodesync.createWorkspace",
        "title": "%cmd.createWorkspace.title%",
        "icon": "$(add)"
      },
      {
        "command": "vscodesync.quickSwitchWorkspace",
        "title": "%cmd.quickSwitchWorkspace.title%"
      },
      {
        "command": "vscodesync.connectCloudWorkspace",
        "title": "%cmd.connectCloudWorkspace.title%"
      },
      {
        "command": "vscodesync.startOnboarding",
        "title": "%cmd.startOnboarding.title%"
      },
      {
        "command": "vscodesync.addCurrentFile",
        "title": "%cmd.addCurrentFile.title%"
      },
      {
        "command": "vscodesync.addFolderToSync",
        "title": "%cmd.addFolderToSync.title%"
      },
      {
        "command": "vscodesync.addToNewWorkspace",
        "title": "%cmd.addToNewWorkspace.title%"
      },
      {
        "command": "vscodesync.pushAll",
        "title": "%cmd.pushAll.title%"
      },
      {
        "command": "vscodesync.pullAll",
        "title": "%cmd.pullAll.title%"
      },
      {
        "command": "vscodesync.syncWorkspace",
        "title": "%cmd.syncWorkspace.title%"
      },
      {
        "command": "vscodesync.pushWorkspace",
        "title": "%cmd.pushWorkspace.title%"
      },
      {
        "command": "vscodesync.pullWorkspace",
        "title": "%cmd.pullWorkspace.title%"
      },
      {
        "command": "vscodesync.detachWorkspace",
        "title": "%cmd.detachWorkspace.title%"
      },
      {
