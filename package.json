{
  "name": "vscodesyncfiles",
  "displayName": "VSCodeSyncFiles",
  "description": "Синхронизация отдельных файлов между машинами через облако",
  "version": "0.4.0",
  "license": "MIT",
  "publisher": "borodatych",
  "repository": {
    "type": "git",
    "url": "https://github.com/borodatych/VSCodeSyncFiles.git"
  },
  "homepage": "https://github.com/borodatych/VSCodeSyncFiles#readme",
  "bugs": {
    "url": "https://github.com/borodatych/VSCodeSyncFiles/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "media/vscodesync.png",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "submenus": [
      {
        "id": "vscodesync.submenu",
        "label": "VSCodeSync"
      }
    ],
    "configuration": {
      "title": "VSCodeSync",
      "properties": {
        "vscodesync.onedriveClientId": {
          "type": "string",
          "default": "",
          "description": "Azure AD public client ID для входа OneDrive (device code)"
        },
        "vscodesync.googleDriveClientId": {
          "type": "string",
          "default": "",
          "description": "OAuth 2.0 Client ID (Desktop) для Google Drive (Google Cloud Console → APIs & Services → Credentials)"
        },
        "vscodesync.dropboxAppKey": {
          "type": "string",
          "default": "lsuphteciqwcykn",
          "description": "App key Dropbox (OAuth). Оставьте пустым для использования встроенного. В консоли приложения добавьте redirect URI: http://127.0.0.1:8734/oauth-callback"
        },
        "vscodesync.yandexOAuthClientId": {
          "type": "string",
          "default": "6ee27a62c3ba4b05a69b682bef342570",
          "description": "OAuth Client ID Яндекса. Оставьте пустым для использования встроенного. Redirect URI: http://127.0.0.1:8735/oauth-callback. Права зависят от vscodesync.yandexUseAppFolder."
        },
        "vscodesync.yandexUseAppFolder": {
          "type": "boolean",
          "default": false,
          "description": "Использовать папку приложения Яндекс Диска (scope: cloud_api:disk.app_folder, путь app:/…). Файлы хранятся в «Приложения/{имя_приложения}/» и недоступны другим приложениям. При изменении этой настройки требуется повторная авторизация."
        },
        "vscodesync.notificationLevel": {
          "type": "string",
          "enum": [
            "minimal",
            "normal",
            "verbose"
          ],
          "default": "normal",
          "description": "Уровень уведомлений VSCodeSync (minimal / normal / verbose)"
        },
        "vscodesync.showFileDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Показывать значки синхронизации на файлах в проводнике"
        },
        "vscodesync.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Максимальный размер одного файла для синхронизации (МБ). 0 — без лимита"
        },
        "vscodesync.warnOnBinaryFiles": {
          "type": "boolean",
          "default": true,
          "description": "Предупреждать перед синхронизацией, если файл похож на двоичный"
        },
        "vscodesync.showPreview": {
          "type": "boolean",
          "default": true,
          "description": "Показывать подтверждение перед добавлением файла в синхронизацию и перед Pull/Push/Sync workspace из панели Workspaces (план в Output + модальное окно)"
        },
        "vscodesync.syncSummaryOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "После запуска VS Code выполнить Pull для активных workspace и показать сводку, если локальное состояние отличается после pull"
        },
        "vscodesync.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "Разрешить телеметрию расширения (агрегаты: провайдер, число workspace, версия). Пути и имена файлов не отправляются. Учитывается также глобальная настройка телеметрии VS Code."
        },
        "vscodesync.telemetryIngestUrl": {
          "type": "string",
          "default": "",
          "description": "Необязательный URL приёма событий (POST JSON). Пусто — только канал телеметрии VS Code, без внешнего сервера (Application Insights / Posthog и т.п.). Только http(s) без учётных данных в URL."
        },
        "vscodesync.quickTransferTtlDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 365,
          "description": "Сколько дней разовая передача (Quick Transfer) хранится в облаке"
        },
        "vscodesync.compressUploads": {
          "type": "boolean",
          "default": false,
          "description": "Gzip сжатие текстовых файлов на загрузке; blob в облаке с суффиксом `.gz`, флаг `_meta.files[].wireGzip`. Несовместимо с шифрованием workspace — при включённом encryption сжатие отключается."
        },
        "vscodesync.lineEnding": {
          "type": "string",
          "enum": [
            "lf",
            "crlf",
            "preserve"
          ],
          "default": "lf",
          "description": "Нормализация окончаний строк при каноническом хэше и синхронизации: lf / crlf / preserve"
        },
        "vscodesync.fileEncoding": {
          "type": "string",
          "enum": [
            "utf8"
          ],
          "default": "utf8",
          "description": "Только UTF-8 в v1; при BOM или невалидном UTF-8 в текстовых файлах показывается предупреждение"
        },
        "vscodesync.workspaceInactiveDays": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "maximum": 3650,
          "description": "Если давность синхронизации (max lastSync среди файлов workspace) превышает столько дней — при старте предложить архивировать (0 — отключить проверку)"
        },
        "vscodesync.batchAddWarnThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Порог количества файлов для предупреждения при пакетном добавлении"
        },
        "vscodesync.pushOnCommit": {
          "type": "boolean",
          "default": false,
          "description": "Триггер push при коммите (фаза Reliability)"
        },
        "vscodesync.conflictRules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Правила разрешения конфликтов (зарезервировано)"
        },
        "vscodesync.localBackupEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Локальный бэкап перед перезаписью при pull"
        },
        "vscodesync.localBackupRetentionDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "description": "Сколько дней хранить файлы в vscodesync-local-backup"
        },
        "vscodesync.snapshotRetentionDays": {
          "type": "number",
          "default": 180,
          "minimum": 1,
          "description": "TTL снапшотов workspace в облаке (дней)"
        },
        "vscodesync.maxSnapshotsPerWorkspace": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Максимум снапшотов на один workspace"
        },
        "vscodesync.longAbsenceThresholdDays": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Порог «долгого отсутствия» для подсказок (дней)"
        },
        "vscodesync.monthlyBandwidthLimitMB": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Лимит трафика в месяц (МБ), 0 — без лимита"
        },
        "vscodesync.syncOnFocusDelayMs": {
          "type": "number",
          "default": 3000,
          "minimum": 0,
          "description": "Задержка sync при фокусе окна (мс, фаза Reliability)"
        },
        "vscodesync.syncOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "При открытии отслеживаемого файла — pull, если в облаке новее (тихий conditional GET)"
        },
        "vscodesync.smartSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "Анализ activity.json: подсказка сгруппировать часто синхронизируемые файлы; ранний вопрос об архиве (~60 дн.) если workspaceInactiveDays > 60"
        },
        "vscodesync.digestIntervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Интервал дайджеста уведомлений (мин)"
        },
        "vscodesync.activityRetentionDays": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 3650,
          "description": "Сколько дней хранить записи Activity Feed в ~/.vscode/vscodeSync/activity.json"
        },
        "vscodesync.requireMachineApproval": {
          "type": "boolean",
          "default": false,
          "description": "Требовать одобрение новой машины в workspace"
        },
        "vscodesync.pauseOnMeteredConnection": {
          "type": "boolean",
          "default": true,
          "description": "Пауза sync на лимитированном соединении"
        },
        "vscodesync.pauseBatteryThreshold": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "maximum": 100,
          "description": "Процент батареи — ниже этого приостанавливать sync (0 — отключено)"
        },
        "vscodesync.encryption": {
          "type": "boolean",
          "default": false,
          "description": "Включить E2E-шифрование (AES-256-GCM) перед загрузкой на облако. Требует наличия ключа в SecretStorage. Первый Push после включения зашифрует данные; Pull на другой машине требует импорта того же ключа."
        },
        "vscodesync.aiMerge": {
          "type": "boolean",
          "default": false,
          "description": "Включить AI-слияние конфликтов через VS Code Language Model API (Copilot). При активном конфликте в диалоге появляется кнопка «✨ Merge with AI». Требует активного Copilot-подписки."
        },
        "vscodesync.webhooks.tunnelEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Запустить встроенный smee.io туннель для webhooks при включённом режиме Watch + webhooks. Туннель даёт публичный URL для OneDrive/Google Drive без белого IP."
        },
        "vscodesync.gitBranchAutoSync": {
          "type": "boolean",
          "default": true,
          "description": "При смене git-ветки: Suspend для VSCodeSync workspace'ов с другим gitBranch в манифесте; активация и sync для совпадающих. Требует расширение Git и настройку gitBranch (команда Set Git Branch for Workspace)."
        },
        "vscodesync.watchMode": {
          "type": "boolean",
          "default": false,
          "description": "Режим наблюдения (фоновый sync — фаза Reliability)"
        },
        "vscodesync.watchIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Интервал опроса в watch mode (сек)"
        },
        "vscodesync.watchMaxIntervalSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "description": "Максимальный интервал backoff watch mode (сек)"
        },
        "vscodesync.watchAdaptive": {
          "type": "boolean",
          "default": true,
          "description": "Адаптивный интервал watch mode"
        },
        "vscodesync.syncSchedule": {
          "type": "object",
          "markdownDescription": "Окно времени для **автоматических** триггеров (onSave debounce, onFocus, onOpen, Git push-on-commit, watch poll, startup pull). Ручные команды VSCodeSync выполняются всегда. Вне окна операции накапливаются в `schedule-deferred.json` в каталоге расширения и выполняются при входе в активное окно.",
          "default": {
            "enabled": false,
            "activeHours": "09:00-18:00",
            "activeDays": [
              "Mon",
              "Tue",
              "Wed",
              "Thu",
              "Fri"
            ],
            "timezone": "auto"
          },
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Включить ограничение автосинхронизации по расписанию"
            },
            "activeHours": {
              "type": "string",
              "default": "09:00-18:00",
              "description": "Интервал локального времени «HH:mm-HH:mm» (допускается переход через полночь)"
            },
            "activeDays": {
              "type": "array",
              "default": [
                "Mon",
                "Tue",
                "Wed",
                "Thu",
                "Fri"
              ],
              "items": {
                "type": "string"
              },
              "description": "Дни недели (Mon…Sun или полные имена). Пустой список = все дни"
            },
            "timezone": {
              "type": "string",
              "default": "auto",
              "description": "IANA (Europe/Moscow) или auto — системная зона"
            }
          },
          "additionalProperties": true
        },
        "vscodesync.deltaSync": {
          "type": "boolean",
          "default": false,
          "description": "Дельта-синхронизация больших файлов"
        },
        "vscodesync.deltaThresholdKB": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Порог размера (КБ) для дельта-sync"
        },
        "vscodesync.webhooks.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Включить webhook уведомления"
        },
        "vscodesync.webhooks.url": {
          "type": "string",
          "default": "",
          "description": "Публичный HTTPS URL для Microsoft Graph (например ngrok → локальный порт). Должен совпадать с тем, что прокидывает туннель на webhooks.localPort."
        },
        "vscodesync.webhooks.localPort": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Локальный HTTP-порт (127.0.0.1) для приёма validation и уведомлений Graph. 0 — не слушать локально (внешний relay сам принимает POST)."
        },
        "vscodesync.webhooks.fallbackAfterMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 10080,
          "description": "Watch Mode: если за это время не было push-уведомлений от Graph, снова использовать interval polling и показать предупреждение. 0 — не переключаться на polling из-за тишины (только пока активна подписка)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscodesync",
          "title": "VSCodeSync",
          "icon": "media/vscodesync.svg"
        }
      ]
    },
    "views": {
      "vscodesync": [
        {
          "id": "vscodesync.workspaces",
          "name": "Workspaces"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "vscodesync",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "push",
              "pull",
              "push-all",
              "pull-all",
              "create-snapshot"
            ],
            "description": "Операция VSCodeSync: sync по workspace, все файлы или снапшот."
          },
          "workspace": {
            "type": "string",
            "description": "Идентификатор облачного workspace. Если в папке один workspace — можно опустить."
          },
          "file": {
            "type": "string",
            "description": "Путь файла относительно корня (POSIX); для push/pull одного файла."
          },
          "snapshotName": {
            "type": "string",
            "description": "Имя снапшота для задачи create-snapshot."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "vscodesync.showStatus",
        "title": "VSCodeSync: Показать статус"
      },
      {
        "command": "vscodesync.createWorkspace",
        "title": "VSCodeSync: Создать воркспейс",
        "icon": "$(add)"
      },
      {
        "command": "vscodesync.connectCloudWorkspace",
        "title": "VSCodeSync: Подключиться к облачному воркспейсу"
      },
      {
        "command": "vscodesync.startOnboarding",
        "title": "VSCodeSync: Запустить мастер настройки"
      },
      {
        "command": "vscodesync.addCurrentFile",
        "title": "VSCodeSync: Добавить файл или папку…"
      },
      {
        "command": "vscodesync.addFolderToSync",
        "title": "VSCodeSync: Добавить папку в синхронизацию"
      },
      {
        "command": "vscodesync.addToNewWorkspace",
        "title": "VSCodeSync: Добавить в новый воркспейс…"
      },
      {
        "command": "vscodesync.pushAll",
        "title": "VSCodeSync: Отправить всё"
      },
      {
        "command": "vscodesync.pullAll",
        "title": "VSCodeSync: Получить всё"
      },
      {
        "command": "vscodesync.syncWorkspace",
        "title": "VSCodeSync: Синхронизировать воркспейс"
      },
      {
        "command": "vscodesync.pushWorkspace",
        "title": "VSCodeSync: Отправить воркспейс..."
      },
      {
        "command": "vscodesync.pullWorkspace",
        "title": "VSCodeSync: Получить воркспейс..."
      },
      {
        "command": "vscodesync.detachWorkspace",
        "title": "VSCodeSync: Отвязать воркспейс..."
      },
      {
        "command": "vscodesync.renameWorkspaceNote",
        "title": "VSCodeSync: Переименовать заметку воркспейса"
      },
      {
        "command": "vscodesync.openSyncSettings",
        "title": "VSCodeSync: Открыть настройки",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vscodesync.toggleTelemetry",
        "title": "VSCodeSync: Переключить телеметрию"
      },
      {
        "command": "vscodesync.showSyncSummary",
        "title": "VSCodeSync: Показать сводку синхронизации"
      },
      {
        "command": "vscodesync.previewSync",
        "title": "VSCodeSync: Предпросмотр синхронизации..."
      },
      {
        "command": "vscodesync.resolveConflicts",
        "title": "VSCodeSync: Разрешить конфликты"
      },
      {
        "command": "vscodesync.keepMine",
        "title": "VSCodeSync: Оставить моё (разрешить конфликт)"
      },
      {
        "command": "vscodesync.takeTheirs",
        "title": "VSCodeSync: Взять чужое (разрешить конфликт)"
      },
      {
        "command": "vscodesync.openConflictDiff3way",
        "title": "VSCodeSync: Открыть трёхстороннее сравнение (конфликт)"
      },
      {
        "command": "vscodesync.setActiveProvider",
        "title": "VSCodeSync: Сменить провайдер"
      },
      {
        "command": "vscodesync.migrateToAnotherProvider",
        "title": "VSCodeSync: Мигрировать на другой провайдер"
      },
      {
        "command": "vscodesync.onedriveSignIn",
        "title": "VSCodeSync: Войти в OneDrive"
      },
      {
        "command": "vscodesync.onedriveSignInHeadless",
        "title": "VSCodeSync: Войти в OneDrive (Device Code, headless)"
      },
      {
        "command": "vscodesync.googleDriveSignIn",
        "title": "VSCodeSync: Войти в Google Drive"
      },
      {
        "command": "vscodesync.googleDriveSignInHeadless",
        "title": "VSCodeSync: Войти в Google Drive (Device Code, headless)"
      },
      {
        "command": "vscodesync.dropboxSignIn",
        "title": "VSCodeSync: Войти в Dropbox"
      },
      {
        "command": "vscodesync.dropboxSignInHeadless",
        "title": "VSCodeSync: Войти в Dropbox (loopback URL in Output)"
      },
      {
        "command": "vscodesync.yandexDiskSignIn",
        "title": "VSCodeSync: Войти в Яндекс Диск"
      },
      {
        "command": "vscodesync.yandexDiskSignInHeadless",
        "title": "VSCodeSync: Войти в Яндекс Диск (loopback URL in Output)"
      },
      {
        "command": "vscodesync.yandexDiskEnterToken",
        "title": "VSCodeSync: Ввести токен Яндекс Диска вручную"
      },
      {
        "command": "vscodesync.showProviderSetupGuide",
        "title": "VSCodeSync: Руководство по настройке провайдера",
        "icon": "$(book)"
      },
      {
        "command": "vscodesync.showCommandCenter",
        "title": "VSCodeSync: Центр команд",
        "icon": "$(list-unordered)"
      },
      {
        "command": "vscodesync.showSettingsPanel",
        "title": "VSCodeSync: Панель настроек",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vscodesync.collapseAllWorkspaces",
        "title": "VSCodeSync: Свернуть всё",
        "icon": "$(collapse-all)"
      },
      {
        "command": "vscodesync.resolveKeepMine",
        "title": "VSCodeSync: Разрешить конфликт — Оставить моё"
      },
      {
        "command": "vscodesync.showSyncDashboard",
        "title": "VSCodeSync: Показать панель синхронизации"
      },
      {
        "command": "vscodesync.focusWorkspacesView",
        "title": "VSCodeSync: Перейти к панели воркспейсов"
      },
      {
        "command": "vscodesync.takeSyncOwnership",
        "title": "VSCodeSync: Стать основным окном синхронизации"
      },
      {
        "command": "vscodesync.refreshWorkspacesView",
        "title": "VSCodeSync: Обновить панель воркспейсов",
        "icon": "$(refresh)"
      },
