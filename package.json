        "title": "%cmd.openSyncSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vscodesync.toggleTelemetry",
        "title": "%cmd.toggleTelemetry.title%"
      },
      {
        "command": "vscodesync.showSyncSummary",
        "title": "%cmd.showSyncSummary.title%"
      },
      {
        "command": "vscodesync.previewSync",
        "title": "%cmd.previewSync.title%"
      },
      {
