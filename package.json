      },
      {
        "command": "vscodesync.yandexDiskSignInHeadless",
        "title": "%cmd.yandexDiskSignInHeadless.title%"
      },
      {
        "command": "vscodesync.yandexDiskEnterToken",
        "title": "%cmd.yandexDiskEnterToken.title%"
      },
      {
        "command": "vscodesync.showProviderSetupGuide",
        "title": "%cmd.showProviderSetupGuide.title%",
        "icon": "$(book)"
      },
      {
        "command": "vscodesync.showCommandCenter",
        "title": "%cmd.showCommandCenter.title%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "vscodesync.showSettingsPanel",
        "title": "%cmd.showSettingsPanel.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vscodesync.collapseAllWorkspaces",
        "title": "%cmd.collapseAllWorkspaces.title%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "vscodesync.resolveKeepMine",
        "title": "%cmd.resolveKeepMine.title%"
      },
      {
        "command": "vscodesync.showSyncDashboard",
        "title": "%cmd.showSyncDashboard.title%"
